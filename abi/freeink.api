# The dessen app API: a projection of the FreeInk SDK.
#
#   <number> <name>(<type> <arg>, ...) [-> <type>] : <host C++ statement>
#
# tools/gen_api.py turns this file into the app-side wrappers (sdk/) and the
# firmware-side dispatch (freeink/). To expose something new, add one line.
#
# Numbers are a compatibility promise: append, never renumber or reuse.
# Types: i32 u32 | i16 u16 u8 (neighbours share one register) |
#        str (text, NUL-terminated copy on the host) | buf (bytes, bounds-checked)
#        out (bytes the host writes back, bounds-checked)
# A call takes at most 7 registers. The statement sees its arguments as local
# variables plus `target`, `screen`, `self` and `vm`; set `result` to return a value.
#
# Coordinates: apps draw in the device's safe area. (0, 0) is its top-left
# corner and `screen` is its size, so nothing an app draws lands under a bezel
# or rounded corner. clip() and pin() translate to panel coordinates.
# Every value from an app is untrusted: clip, pin or range-check it here.

# --- core (0-15) ---
0  exit(i32 code)             : return kExit;
1  wait_event() -> u32        : return kWait;
2  refresh()                  : self.refresh_ = true; return kYield;
3  screen() -> u32            : result = static_cast<uint32_t>(screen.width) << 16 | static_cast<uint16_t>(screen.height);
4  random() -> u32            : result = self.nextRandom();
5  device(out info) -> u32    : result = writeDeviceInfo(self.device_, screen, self.services() ? self.services()->buttonHintsHeight() : 0, info, info_len);

# --- freeink::ui::DrawTarget (16-31) ---
16 clear()                    : target.fill(self.device_.screen(), Paint::solid(Color::White));
17 fill(i16 x, i16 y, i16 w, i16 h, u8 color) : if (const Rect r = clip(x, y, w, h, screen); !r.empty()) target.fill(r, paint(color));
18 fill_round(i16 x, i16 y, i16 w, i16 h, u8 color, u8 radius, u8 corners) : if (const Rect r = clip(x, y, w, h, screen); !r.empty()) target.fill(r, paint(color), radius, corners & CornersAll);
19 stroke(i16 x, i16 y, i16 w, i16 h, u8 color, u8 width, u8 radius, u8 corners) : if (const Rect r = clip(x, y, w, h, screen); !r.empty()) target.stroke(r, paint(color), width ? width : 1, radius, corners & CornersAll);
20 line(i16 x0, i16 y0, i16 x1, i16 y1, u8 width, u8 color) : if (screen.width > 0 && screen.height > 0) target.line(pin(x0, y0, screen), pin(x1, y1, screen), width < 1 ? 1 : width > 8 ? 8 : width, paint(color));
21 triangle(i16 ax, i16 ay, i16 bx, i16 by, i16 cx, i16 cy, u8 color) : if (screen.width > 0 && screen.height > 0) target.triangle(pin(ax, ay, screen), pin(bx, by, screen), pin(cx, cy, screen), paint(color));
22 text_box(i16 x, i16 y, i16 w, i16 h, str s, u8 font, u8 align, u8 max_lines, u8 flags) -> i32 : result = drawText(target, screen, x, y, w, h, s, textStyle(font, align, max_lines, flags));
23 measure_text(str s, u8 font, u8 flags) -> u32 : { const TextStyle st = textStyle(font, 0, 1, flags); const Size m = target.measureText(st.font, s, st); result = static_cast<uint32_t>(static_cast<uint16_t>(m.width)) << 16 | static_cast<uint16_t>(m.height); }
24 line_height(u8 font) -> i32 : result = static_cast<uint32_t>(target.lineHeight(textStyle(font, 0, 1, 0).font));
25 bitmap(i16 x, i16 y, i16 w, i16 h, buf data, u16 bw, u16 bh, u8 format, u8 mode, u8 color, u8 rotation) -> i32 : result = drawBitmap(target, screen, x, y, w, h, data, data_len, bw, bh, format, mode, color, rotation);
# set_clip limits every later draw to a rectangle of the safe area, until the
# next set_clip; a negative width lifts it. The firmware's own clip is restored
# whenever the app stops running, so the app's never reaches firmware drawing.
26 set_clip(i16 x, i16 y, i16 w, i16 h) -> i32 : result = self.setClip(x, y, w, h);
# button_hints: the host draws its own hints, in its own look, over its keys;
# labels are back, confirm, previous, next, one per line. dsn_device's
# hint_height says whether it will (0: it ignores this) and how much to leave.
27 button_hints(buf labels) -> i32 : result = self.buttonHints(labels, labels_len);

# ==== Capabilities (see docs/proposed-capabilities.md). Each host statement
# ==== sanitizes app input, then calls a Services method; async calls return a
# ==== stop code via a begin* helper. No protocol/vendor names appear here.

# --- core (32-39) ---
32 time() -> u32               : result = self.services() ? self.services()->timeNow() : 0;
33 device_id(out id) -> i32    : result = svcDeviceId(self, id, id_len);
35 clock(out t) -> i32         : result = svcClock(self, t, t_len);
34 random_bytes(out buf) -> i32 : self.randomBytesInto(buf, buf_len); result = buf_len;
36 locale(out code) -> i32     : result = self.services() ? self.services()->locale(reinterpret_cast<char*>(code), code_len) : DSN_ERR_UNAVAILABLE;

# --- UI (40-47) ---
# text_input is a capability, not an app-drawn widget: the app asks for text and
# the firmware runs its own on-screen keyboard (KeyboardEntryActivity).
40 text_input(str prompt, out text) -> i32 : return self.beginTextInput(prompt, text, text_len);

# --- storage (48-55) ---
48 fs_list(buf path, out entries) -> i32 : result = svcFs(self, 'l', path, path_len, entries, entries_len, 0, 0);
49 fs_read(buf path, out data) -> i32    : result = svcFs(self, 'r', path, path_len, data, data_len, 0, 0);
50 fs_write(buf path, buf data) -> i32   : result = svcFs(self, 'w', path, path_len, (uint8_t*)data, data_len, 0, 0);
51 fs_delete(buf path) -> i32            : result = svcFs(self, 'd', path, path_len, 0, 0, 0, 0);
52 fs_app_dir(out path) -> i32           : result = svcFs(self, 'a', 0, 0, path, path_len, 0, 0);
53 keystore(buf path, buf key, u32 expires) -> i32 : result = svcFs(self, 'k', path, path_len, (uint8_t*)key, key_len, 0, expires);
# Ranged read for files larger than app memory: up to data_len bytes from offset; 0 at end of file.
54 fs_read_at(buf path, u32 offset, out data) -> i32 : result = svcFs(self, 'R', path, path_len, data, data_len, offset, 0);

# --- network (56-63), async ---
56 net_request(buf head, buf body, out resp) -> i32 : return self.beginNet(head, head_len, body, body_len, resp, resp_len);
57 fetch_to_sd(buf url, buf dest) -> i32            : return self.beginFetch(url, url_len, dest, dest_len);

# --- crypto (64-79) ---
64 hash(u8 algo, buf data, out digest) -> i32            : result = svcHash(self, (int)algo, data, data_len, digest, digest_len);
65 aes_cbc(u8 flags, buf keyiv, buf data, out dst) -> i32 : result = svcAes(self, (int)flags, keyiv, keyiv_len, data, data_len, dst, dst_len);
66 rsa_keygen(u16 bits, out pub, out priv) -> i32        : return self.beginKeygen(bits, pub, pub_len, priv, priv_len);
67 rsa_encrypt(buf cert, buf data, out ct) -> i32        : result = svcRsa(self, 'e', 0, cert, cert_len, data, data_len, ct, ct_len);
68 rsa_decrypt(u8 flags, buf priv, buf data, out pt) -> i32 : result = svcRsa(self, 'd', (int)flags, priv, priv_len, data, data_len, pt, pt_len);
69 rsa_sign(u8 algo, buf priv, buf digest, out sig) -> i32 : result = svcRsa(self, 's', (int)algo, priv, priv_len, digest, digest_len, sig, sig_len);
70 pkcs12_parse(buf p12, str pass, out blob) -> i32      : result = svcPkcs12(self, p12, p12_len, pass, blob, blob_len);

# --- board services (80-95) ---
80 backlight(i16 brightness, i16 warm) -> i32 : result = self.services() ? self.services()->backlightSet(brightness, warm) : DSN_ERR_UNAVAILABLE;
81 backlight_get() -> i32                      : result = self.services() ? self.services()->backlightGet() : DSN_ERR_UNAVAILABLE;
82 battery() -> i32                            : result = self.services() ? self.services()->battery() : DSN_ERR_UNAVAILABLE;
83 haptic(u16 ms, u8 intensity) -> i32         : result = self.services() ? self.services()->haptic((int)ms, (int)intensity) : DSN_ERR_UNAVAILABLE;
84 accel(out xyz) -> i32                       : result = svcAccel(self, xyz, xyz_len);

# --- launcher / home (96-103). The open_* calls hand off to a firmware screen
# --- and end the app (State::Launch), so a home app uses them like dsn_exit. ---
96 open_book(buf path) -> i32      : return self.requestLaunch(1, path, path_len);
97 open_settings() -> i32          : return self.requestLaunch(2, 0, 0);
98 open_browser() -> i32           : return self.requestLaunch(3, 0, 0);
102 open_app(buf path) -> i32      : return self.requestLaunch(4, path, path_len);
99 recents(out list) -> i32        : result = self.services() ? self.services()->recents(reinterpret_cast<char*>(list), list_len) : DSN_ERR_UNAVAILABLE;
104 recent_shelf(u32 first, u16 count, out list) -> i32 : if (count > DSN_SHELF_PAGE_MAX) result = DSN_ERR_INVALID; else if (self.services()) result = self.services()->recentShelf(first, count, reinterpret_cast<char*>(list), list_len); else result = DSN_ERR_UNAVAILABLE;
100 book_progress(buf path) -> i32 : result = svcProgress(self, path, path_len);
101 open_home(u8 dest) -> i32   : return self.requestLaunchHome((int)dest);
103 wifi_connect() -> i32 : return self.beginWifi();
105 book_cover(buf path, u16 height, out pixels) -> i32 : result = svcBookCover(self, path, path_len, height, pixels, pixels_len);
107 timer_set(u32 interval_ms) -> i32 : result = self.setTimerInterval(interval_ms);
106 qr_bitmap(buf link, out pixels) -> i32 : result = self.services() ? self.services()->qrBitmap(reinterpret_cast<const char*>(link), link_len, pixels, pixels_len) : DSN_ERR_UNAVAILABLE;

# --- read-only reading history ---
108 reading_stats_start(buf book, u32 anchor_day) -> i32 : return self.beginReadingStats(book, book_len, anchor_day);
109 reading_stats_read(u32 kind, u32 first, out data) -> i32 : result = self.services() ? self.services()->readingStatsRead(kind, first, data, data_len) : DSN_ERR_UNAVAILABLE;

# --- generic filesystem operations ---
110 screenshot(buf path) -> i32 : result = svcScreenshot(self, path, path_len);
111 fs_rename(buf source, buf dest) -> i32 : result = svcRename(self, source, source_len, dest, dest_len);
